@model IEnumerable<DevPruebaPSC.Models.Venta>

@{
    ViewBag.Title = "Gestion de Ventas";
    Layout = "~/Views/Shared/_Layout.cshtml";
}


<div class="page-header-bar">
    <h2 class="page-title">Historial de Ventas</h2>
</div>

@using (Html.BeginForm("Sales", "Ventas", FormMethod.Get))
{
    <div class="search-bar">
        <span style="font-weight:600; color:#555;">Buscar por cédula:</span>
        <input type="text" name="searchCedula" class="form-control" value="@ViewBag.SearchCedula" />
        <button type="submit" class="btn btn-primary">Buscar</button>
        @if (!string.IsNullOrEmpty(ViewBag.SearchCedula as string))
        {
            <a href="@Url.Action("Sales", "Ventas")" class="btn btn-secondary">Limpiar</a>
        }
    </div>
}

<div class="table-responsive table-ventas">
    <table class="table table-hover mb-0">
        <thead>
            <tr>
                <th>ID Venta</th>
                <th>ID Vehiculo</th>
                <th>ID Vendedor</th>
                <th>Fecha</th>
                <th>Precio</th>
                <th>Acciones</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>@item.ventaId</td>
                    <td>@item.vehiculoId</td>
                    <td>@item.cedula</td>
                    <td>@item.fechaVenta.ToString("dd/MM/yyyy")</td>
                    <td>@item.precioTotal</td>
                    <td>
                        <button class="btn-action btn-info-custom" onclick="abrirModalDetalles(
                                    @item.ventaId,
                                    @item.vehiculoId,
                                    '@item.cedula',
                                    '@item.fechaVenta.ToString("dd/MM/yyyy")',
                                    '@String.Format("{0:N0}", item.precioTotal)',
                                    '@Html.Raw(Html.Encode(item.Vehiculo != null ? item.Vehiculo.modelo : "-"))',
                                    '@Html.Raw(Html.Encode(item.Vendedore != null ? item.Vendedore.nombre + " " + item.Vendedore.apellido : item.cedula))'
                                )">
                            Detalles
                        </button>
                        <button class="btn-action btn-delete"
                                onclick="abrirModalEliminarVenta(
                                    @item.ventaId,
                                    '@item.cedula',
                                    '@item.fechaVenta.ToString("dd/MM/yyyy")',
                                    '$@String.Format("{0:N0}", item.precioTotal)',
                                    '@Html.Raw(Html.Encode(item.Vehiculo != null ? item.Vehiculo.modelo : "-"))'
                                )">
                            Eliminar
                        </button>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>

@* Panel para Consulta de Vehículos Vendidos por Vendedor (sp_VehXVendedor) *@
<div style="margin-top: 35px;">
    <div style="background:white; border-radius:12px; box-shadow:0 2px 12px rgba(0,0,0,0.08); overflow:hidden;">

        <div style="background:#1a3a5c; color:white; padding:16px 22px; display:flex; align-items:center; gap:10px;">
            <span style="font-weight:700; font-size:1rem; text-transform:uppercase; letter-spacing:0.5px;">
                Vehículos Vendidos por Vendedor
            </span>
        </div>

        <div style="padding:20px 22px; background:#f8fafc; border-bottom:1px solid #e9ecef;">
            <div style="display:flex; align-items:center; gap:12px; flex-wrap:wrap;">
                <label style="font-weight:600; color:#555; white-space:nowrap;">Cédula del vendedor:</label>
                <input type="text" id="spCedula"
                       style="border:1.5px solid #dde2e8; border-radius:7px; padding:8px 14px;
                              font-size:0.95rem; min-width:220px;" />
                <button onclick="consultarVehiculosSP()"
                        style="background:#1a3a5c; color:white; border:none; border-radius:7px;
                               padding:9px 20px; font-weight:600; cursor:pointer; font-size:0.9rem;">
                    Consultar
                </button>
                <button onclick="limpiarResultadoSP()"
                        style="background:#6c757d; color:white; border:none; border-radius:7px;
                               padding:9px 16px; font-weight:600; cursor:pointer; font-size:0.9rem;">
                    Limpiar
                </button>
            </div>
        </div>

        <div id="spResultado" style="padding:22px; min-height:80px;">
            <p style="color:#aaa; text-align:center; margin:0;">
                Ingresa una cédula y presiona <strong>Consultar</strong> para ver los vehículos vendidos.
            </p>
        </div>

    </div>
</div>

@* Modal para Detalles de Venta *@
<div class="modal fade" id="modalDetallesVenta" tabindex="-1" role="dialog" aria-hidden="true">
    <div class="modal-dialog modal-lg" role="document">
        <div class="modal-content" style="border-radius:12px; border:none; box-shadow:0 8px 40px rgba(0,0,0,0.18);">
            <div class="modal-header-custom details">
                <h5 class="modal-title-custom">Detalle de Venta <span id="det_titulo"></span></h5>
            </div>
            <div class="modal-body-custom">
                <div class="detail-grid">
                    <div class="detail-item">
                        <div class="detail-label">ID Venta</div>
                        <div class="detail-value" id="det_ventaId"></div>
                    </div>
                    <div class="detail-item">
                        <div class="detail-label">ID Vehículo</div>
                        <div class="detail-value" id="det_vehiculoId"></div>
                    </div>
                    <div class="detail-item">
                        <div class="detail-label">Modelo Vehículo</div>
                        <div class="detail-value" id="det_modelo"></div>
                    </div>
                    <div class="detail-item">
                        <div class="detail-label">Cédula Vendedor</div>
                        <div class="detail-value" id="det_cedula"></div>
                    </div>
                    <div class="detail-item">
                        <div class="detail-label">Nombre Vendedor</div>
                        <div class="detail-value" id="det_vendedor"></div>
                    </div>
                    <div class="detail-item">
                        <div class="detail-label">Fecha de Venta</div>
                        <div class="detail-value" id="det_fecha"></div>
                    </div>
                    <div class="detail-item full-width">
                        <div class="detail-label">Precio Total</div>
                        <div class="detail-value" id="det_precio" style="color:#065f46; font-size:1.2rem;"></div>
                    </div>
                </div>
            </div>
            <div class="modal-footer-custom">
                <button type="button" class="btn btn-secondary" data-dismiss="modal" onclick="cerrarModalDetalles()">Cerrar</button>
            </div>
        </div>
    </div>
</div>

@* Modal para Eliminar Venta *@
<div class="modal fade" id="modalEliminarVenta" tabindex="-1" role="dialog" aria-hidden="true">
    <div class="modal-dialog" role="document">
        <div class="modal-content" style="border-radius:12px; border:none; box-shadow:0 8px 40px rgba(0,0,0,0.18);">
            <div class="modal-header-custom delete">
                <h5 class="modal-title-custom">Eliminar Venta</h5>
            </div>
            @using (Html.BeginForm("Delete", "Ventas", FormMethod.Post, new { id = "formEliminarVenta" }))
            {
                @Html.AntiForgeryToken()
                <div class="modal-body-custom">
                    <input type="hidden" id="del_ventaId_input" name="id" />

                    <div class="delete-info-card">
                        <div class="info-row">
                            <span class="info-label">ID Venta:</span>
                            <span class="info-value" id="del_ventaId_txt"></span>
                        </div>
                        <div class="info-row">
                            <span class="info-label">Vehículo:</span>
                            <span class="info-value" id="del_modelo_txt"></span>
                        </div>
                        <div class="info-row">
                            <span class="info-label">Cédula Vendedor:</span>
                            <span class="info-value" id="del_cedula_txt"></span>
                        </div>
                        <div class="info-row">
                            <span class="info-label">Fecha:</span>
                            <span class="info-value" id="del_fecha_txt"></span>
                        </div>
                        <div class="info-row">
                            <span class="info-label">Precio Total:</span>
                            <span class="info-value" id="del_precio_txt"></span>
                        </div>
                    </div>

                    <div class="alert-delete">
                        <span>Esta acción es <strong>permanente</strong> y no se puede deshacer.</span>
                    </div>
                </div>
                <div class="modal-footer-custom">
                    <button type="button" class="btn btn-secondary" data-dismiss="modal" onclick="cerrarModalEliminarVenta()">Cancelar</button>
                    <button type="submit" class="btn btn-danger">Sí, eliminar</button>
                </div>
            }
        </div>
    </div>
</div>

@section Scripts {
    @Scripts.Render("~/bundles/jqueryval")
    <script>
        function abrirModalDetalles(ventaId, vehiculoId, cedula, fecha, precio, modelo, vendedor) {
            $('#det_titulo').text('#' + ventaId);
            $('#det_ventaId').text(ventaId);
            $('#det_vehiculoId').text(vehiculoId);
            $('#det_cedula').text(cedula);
            $('#det_fecha').text(fecha);
            $('#det_precio').text('$' + precio);
            $('#det_modelo').text(modelo);
            $('#det_vendedor').text(vendedor);
            $('#modalDetallesVenta').modal('show');
        }

        function cerrarModalDetalles() {
            $('#modalDetallesVenta').modal('hide');
        }

        function abrirModalEliminarVenta(ventaId, cedula, fecha, precio, modelo) {
            $('#del_ventaId_input').val(ventaId);
            $('#del_ventaId_txt').text(ventaId);
            $('#del_cedula_txt').text(cedula);
            $('#del_fecha_txt').text(fecha);
            $('#del_precio_txt').text(precio);
            $('#del_modelo_txt').text(modelo);
            $('#modalEliminarVenta').modal('show');
        }

        function cerrarModalEliminarVenta() {
            $('#modalEliminarVenta').modal('hide');
        }

        function consultarVehiculosSP() {
            var cedula = $('#spCedula').val().trim();

            if (!cedula) {
                $('#spResultado').html(
                    '<div style="color:#b91c1c;background:#fef2f2;border:1px solid #fca5a5;' +
                    'border-radius:8px;padding:12px 16px;">&#9888; Por favor ingresa una cédula.</div>'
                );
                return;
            }

            $('#spResultado').html(
                '<div style="text-align:center;padding:20px;color:#555;">&#8987; Consultando...</div>'
            );

            $.ajax({
                url: '@Url.Action("VehiculosPorVendedor", "Ventas")',
                type: 'GET',
                data: { cedula: cedula },
                success: function (data) {

                    if (data.error) {
                        $('#spResultado').html(
                            '<div style="color:#b91c1c;background:#fef2f2;border:1px solid #fca5a5;' +
                            'border-radius:8px;padding:12px 16px;">&#9888; ' + data.error + '</div>'
                        );
                        return;
                    }

                    var html = '<p style="font-weight:600;color:#555;margin-bottom:12px;">' +
                            data.length + ' vehículo(s) vendido(s) — cédula: <strong>' + cedula + '</strong></p>';

                    html += '<div style="border-radius:8px;overflow:hidden;border:1px solid #e9ecef;">';
                    html += '<table class="table table-hover mb-0"><thead>';
                    html += '<tr style="background:#e8f0fe;">' +
                            '<th style="padding:10px 14px;font-size:0.82rem;color:#1a56db;">ID Venta</th>' +
                            '<th style="padding:10px 14px;font-size:0.82rem;color:#1a56db;">Fecha Venta</th>' +
                            '<th style="padding:10px 14px;font-size:0.82rem;color:#1a56db;">ID Vehículo</th>' +
                            '<th style="padding:10px 14px;font-size:0.82rem;color:#1a56db;">Marca</th>' +
                            '<th style="padding:10px 14px;font-size:0.82rem;color:#1a56db;">Modelo</th>' +
                            '<th style="padding:10px 14px;font-size:0.82rem;color:#1a56db;">Año</th>' +
                            '<th style="padding:10px 14px;font-size:0.82rem;color:#1a56db;">Precio</th>' +
                            '</tr></thead><tbody>';

                    $.each(data, function (i, v) {
                        html += '<tr>' +
                                '<td style="padding:10px 14px;">' +
                                    '<span style="background:#e8f0fe;color:#1a56db;padding:3px 10px;border-radius:20px;font-weight:600;">#' + v.ventaId + '</span>' +
                                '</td>' +
                                '<td style="padding:10px 14px;">' + v.fechaVenta + '</td>' +
                                '<td style="padding:10px 14px;">' + v.vehiculoId + '</td>' +
                                '<td style="padding:10px 14px;font-weight:600;">' + v.marca + '</td>' +
                                '<td style="padding:10px 14px;">' + v.modelo + '</td>' +
                                '<td style="padding:10px 14px;">' + v.anio + '</td>' +
                                '<td style="padding:10px 14px;">' +
                                    '<span style="background:#ecfdf5;color:#065f46;padding:3px 10px;border-radius:20px;font-weight:600;">' +
                                    '$' + Number(v.precio).toLocaleString() + '</span>' +
                                '</td>' +
                                '</tr>';
                    });

                    html += '</tbody></table></div>';
                    $('#spResultado').html(html);
                },
                error: function () {
                    $('#spResultado').html(
                        '<div style="color:#b91c1c;background:#fef2f2;border:1px solid #fca5a5;' +
                        'border-radius:8px;padding:12px 16px;">&#9888; Error de conexión al servidor.</div>'
                    );
                }
            });
        }

        function limpiarResultadoSP() {
            $('#spCedula').val('');
            ('#spResultado').html(
                '<p style="color:#aaa;text-align:center;margin:0;">' +
                'Ingresa una cédula y presiona <strong>Consultar</strong> para ver los vehículos vendidos.</p>'
            );
        }

        $(document).ready(function () {
            $('#spCedula').on('keypress', function (e) {
                if (e.which === 13) consultarVehiculosSP();
            });
        });
    </script>
}