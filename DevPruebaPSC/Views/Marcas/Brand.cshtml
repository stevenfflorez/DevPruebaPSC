@model IEnumerable<DevPruebaPSC.Models.Marca>

@{
    ViewBag.Title = "Marca";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="page-header-bar">
    <h2 class="page-title">Marcas</h2>
    <button class="btn btn-success" onclick="abrirModalCrearMarca()">Agregar Marca</button>
</div>

<div class="table-responsive table-marcas">
    <table class="table table-hover mb-0">
        <thead>
            <tr>
                <th>ID</th>
                <th>Nombre</th>
                <th>Acciones</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>
                        @Html.DisplayFor(modelItem => item.marcaId)
                    </td>
                    <td>
                        @Html.DisplayFor(modelItem => item.nombre)
                    </td>
                    <td>
                        <button class="btn-action btn-edit" onclick="abrirModalEditarMarca(@item.marcaId, '@Html.Raw(Html.Encode(item.nombre))')">
                            Editar
                        </button>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>

@* Modal para Crear Marca *@
<div class="modal fade" id="modalCrearMarca" tabindex="-1" role="dialog" aria-hidden="true">
    <div class="modal-dialog" role="document">
        <div class="modal-content" style="border-radius:12px; border:none; box-shadow:0 8px 40px rgba(0,0,0,0.18);">
            <div class="modal-header-custom create">
                <h5 class="modal-title-custom">Agregar Nueva Marca</h5>
            </div>
            @using (Html.BeginForm("Create", "Marcas", FormMethod.Post, new { id = "formCrearMarca" }))
            {
                @Html.AntiForgeryToken()
                <div class="modal-body-custom">
                    @Html.ValidationSummary(true, "", new { @class = "text-danger" })
                    <div class="form-group">
                        <label>Nombre de la Marca <span class="text-danger">*</span></label>
                        <input type="text" name="nombre" id="crear_nombre"
                               class="form-control form-control-custom"
                               required />
                        <small class="text-muted">Ingresa el nombre comercial de la marca.</small>
                    </div>
                </div>
                <div class="modal-footer-custom">
                    <button type="button" class="btn btn-secondary" onclick="cerrarModalCrearMarca()">Cancelar</button>
                    <button type="submit" class="btn btn-success">Guardar Marca</button>
                </div>
            }
        </div>
    </div>
</div>


@* Modal para Editar Marca *@
<div class="modal fade" id="modalEditarMarca" tabindex="-1" role="dialog" aria-hidden="true">
    <div class="modal-dialog" role="document">
        <div class="modal-content" style="border-radius:12px; border:none; box-shadow:0 8px 40px rgba(0,0,0,0.18);">
            <div class="modal-header-custom edit">
                <h5 class="modal-title-custom">Editar Marca</h5>
            </div>
            @using (Html.BeginForm("Edit", "Marcas", FormMethod.Post, new { id = "formEditarMarca" }))
            {
                @Html.AntiForgeryToken()
                <div class="modal-body-custom">
                    @Html.ValidationSummary(true, "", new { @class = "text-danger" })
                    <input type="hidden" id="edit_marcaId" name="marcaId" />
                    <div class="form-group">
                        <label>Nombre de la Marca <span class="text-danger">*</span></label>
                        <input type="text" id="edit_marcaNombre" name="nombre"
                               class="form-control form-control-custom"
                               required />
                    </div>
                </div>
                <div class="modal-footer-custom">
                    <button type="button" class="btn btn-secondary" data-dismiss="modal">Cancelar</button>
                    <button type="submit" class="btn btn-primary">Guardar Cambios</button>
                </div>
            }
        </div>
    </div>
</div>


@section Scripts {
    @Scripts.Render("~/bundles/jqueryval")
<script>
    function abrirModalCrearMarca() {
        $('#formCrearMarca')[0].reset();
        $('#modalCrearMarca').modal('show');
    }

    function cerrarModalCrearMarca() {
        $('#formCrearMarca')[0].reset();
        $('#modalCrearMarca').modal('hide');
    }

    function abrirModalEditarMarca(marcaId, nombre) {
        $('#edit_marcaId').val(marcaId);
        $('#edit_marcaNombre').val(nombre);
        $('#modalEditarMarca').modal('show');
    }

    function cerrarModalEditarMarca() {
        $('#formEditarMarca')[0].reset();
        $('#modalEditarMarca').modal('hide');
    }
</script>
}