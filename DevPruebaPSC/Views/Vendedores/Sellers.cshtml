@model IEnumerable<DevPruebaPSC.Models.Vendedore>

@{
    ViewBag.Title = "Vendedores";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<br />

<div class="page-header-bar">
    <h2 class="page-title">Lista de Vendedores</h2>
    <button class="btn btn-success" onclick="abrirModalAgregar()">Agregar Vendedor</button>
</div>

<br />

<div class="table-responsive table-vendedores">
    <table class="table table-hover mb-0">
        <thead>
            <tr>
                <th>Cédula</th>
                <th>Nombre</th>
                <th>Apellido</th>
                <th>Teléfono</th>
                <th>Email</th>
                <th>Acciones</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>@item.cedula</td>
                    <td>@item.nombre</td>
                    <td>@item.apellido</td>
                    <td>@item.telefono</td>
                    <td>@item.email</td>
                    <td>
                        <button class="btn-action btn-edit" onclick="abrirModalEditar('@item.cedula',
                            '@Html.Raw(Html.Encode(item.nombre))', '@Html.Raw(Html.Encode(item.apellido))', '@item.telefono', '@item.email')">
                            Editar
                        </button>
                        <button class="btn-action btn-delete" onclick="abrirModalEliminar('@item.cedula',
                            '@Html.Raw(Html.Encode(item.nombre))', '@Html.Raw(Html.Encode(item.apellido))', '@item.email')">
                            Eliminar
                        </button>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>


@* Modal Agregar Vendedor *@
<div class="modal fade" id="modalCrear" tabindex="-1" role="dialog" aria-hidden="true">
    <div class="modal-dialog modal-lg" role="document">
        <div class="modal-content" style="border-radius:12px; border:none; box-shadow:0 8px 40px rgba(0,0,0,0.18);">
            <div class="modal-header-custom create">
                <h5 class="modal-title-custom">Agregar Nuevo Vendedor</h5>
            </div>
            @using (Html.BeginForm("Create", "Vendedores", FormMethod.Post, new { id = "formCrear" }))
            {
                @Html.AntiForgeryToken()
                <div class="modal-body-custom">
                    @Html.ValidationSummary(true, "", new { @class = "text-danger" })
                    <div class="row">
                        <div class="col-md-6 form-group">
                            <label>Cédula *</label>
                            @Html.TextBox("cedula", null, new { @class = "form-control form-control-custom", required = "required" })
                        </div>
                        <div class="col-md-6 form-group">
                            <label>Nombre *</label>
                            @Html.TextBox("nombre", null, new { @class = "form-control form-control-custom", required = "required" })
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-md-6 form-group">
                            <label>Apellido *</label>
                            @Html.TextBox("apellido", null, new { @class = "form-control form-control-custom", required = "required" })
                        </div>
                        <div class="col-md-6 form-group">
                            <label>Teléfono</label>
                            @Html.TextBox("telefono", null, new { @class = "form-control form-control-custom" })
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-md-12 form-group">
                            <label>Email</label>
                            @Html.TextBox("email", null, new { @class = "form-control form-control-custom", type = "email" })
                        </div>
                    </div>
                </div>
                <div class="modal-footer-custom">
                    <button type="button" class="btn btn-secondary" onclick="cerrarModalAgregar()">Cancelar</button>
                    <button type="submit" class="btn btn-success">Guardar Vendedor</button>
                </div>
            }
        </div>
    </div>
</div>

@* Modal Editar Vendedor *@
<div class="modal fade" id="modalEditar" tabindex="-1" role="dialog" aria-hidden="true">
    <div class="modal-dialog modal-lg" role="document">
        <div class="modal-content" style="border-radius:12px; border:none; box-shadow:0 8px 40px rgba(0,0,0,0.18);">
            <div class="modal-header-custom edit">
                <h5 class="modal-title-custom">Editar Vendedor</h5>
            </div>
            @using (Html.BeginForm("Edit", "Vendedores", FormMethod.Post, new { id = "formEditar" }))
            {
                @Html.AntiForgeryToken()
                <div class="modal-body-custom">
                    @Html.ValidationSummary(true, "", new { @class = "text-danger" })
                    <input type="hidden" id="edit_cedula" name="cedula" />
                    <div class="row">
                        <div class="col-md-6 form-group">
                            <label>Cédula</label>
                            <input type="text" id="edit_cedula_display" class="form-control form-control-custom"
                                   style="background:#f8f9fa; color:#888;" readonly />
                            <small class="text-muted">La cédula no puede modificarse.</small>
                        </div>
                        <div class="col-md-6 form-group">
                            <label>Nombre <span class="text-danger">*</span></label>
                            <input type="text" id="edit_nombre" name="nombre"
                                   class="form-control form-control-custom" required />
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-md-6 form-group">
                            <label>Apellido <span class="text-danger">*</span></label>
                            <input type="text" id="edit_apellido" name="apellido"
                                   class="form-control form-control-custom" required />
                        </div>
                        <div class="col-md-6 form-group">
                            <label>Teléfono</label>
                            <input type="text" id="edit_telefono" name="telefono"
                                   class="form-control form-control-custom" />
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-md-12 form-group">
                            <label>Email</label>
                            <input type="email" id="edit_email" name="email"
                                   class="form-control form-control-custom" />
                        </div>
                    </div>
                </div>
                <div class="modal-footer-custom">
                    <button type="button" class="btn btn-secondary" onclick="cerrarModalEditar()">Cancelar</button>
                    <button type="submit" class="btn btn-primary">Guardar Cambios</button>
                </div>
            }
        </div>
    </div>
</div>

@* Modal Eliminar Vendedor *@
<div class="modal fade" id="modalEliminar" tabindex="-1" role="dialog" aria-hidden="true">
    <div class="modal-dialog" role="document">
        <div class="modal-content" style="border-radius:12px; border:none; box-shadow:0 8px 40px rgba(0,0,0,0.18);">
            <div class="modal-header-custom delete">
                <h5 class="modal-title-custom">Eliminar Vendedor</h5>
            </div>
            @using (Html.BeginForm("Delete", "Vendedores", FormMethod.Post, new { id = "formEliminar" }))
            {
                @Html.AntiForgeryToken()
                <div class="modal-body-custom">
                    <input type="hidden" id="delete_cedula" name="id" />

                    <div class="delete-info-card">
                        <div class="info-row">
                            <span class="info-label">Cédula:</span>
                            <span class="info-value" id="del_cedula_txt"></span>
                        </div>
                        <div class="info-row">
                            <span class="info-label">Nombre:</span>
                            <span class="info-value" id="del_nombre_txt"></span>
                        </div>
                        <div class="info-row">
                            <span class="info-label">Apellido:</span>
                            <span class="info-value" id="del_apellido_txt"></span>
                        </div>
                        <div class="info-row">
                            <span class="info-label">Email:</span>
                            <span class="info-value" id="del_email_txt"></span>
                        </div>
                    </div>

                    <div class="alert-delete">
                        <span>Esta acción es <strong>permanente</strong> y no se puede deshacer.</span>
                    </div>
                </div>
                <div class="modal-footer-custom">
                    <button type="button" class="btn btn-secondary" onclick="cerrarModalEliminar()">Cancelar</button>
                    <button type="submit" class="btn btn-danger">Sí, eliminar</button>
                </div>
            }
        </div>
    </div>
</div>

@section Scripts {
    @Scripts.Render("~/bundles/jqueryval")
<script>
    // Abrir modal Agregar Vendedor con formulario limpio
    function abrirModalAgregar() {
        $('#formCrear')[0].reset();
        $('#modalCrear').modal('show');
    }

    // Cerrar modal Agregar y limpiar campos
    function cerrarModalAgregar() {
        $('#formCrear')[0].reset();
        $('#modalCrear').modal('hide');
    }

    // Abrir modal EDITAR con datos precargados
    function abrirModalEditar(cedula, nombre, apellido, telefono, email) {
        $('#edit_cedula').val(cedula);
        $('#edit_cedula_display').val(cedula);
        $('#edit_nombre').val(nombre);
        $('#edit_apellido').val(apellido);
        $('#edit_telefono').val(telefono);
        $('#edit_email').val(email);
        $('#modalEditar').modal('show');
    }

    // Cerrar modal Editar y limpiar campos
    function cerrarModalEditar() {
        $('#formEditar')[0].reset();
        $('#modalEditar').modal('hide');
    }

    // Abrir modal ELIMINAR con datos del vendedor
    function abrirModalEliminar(cedula, nombre, apellido, email) {
        $('#delete_cedula').val(cedula);
        $('#del_cedula_txt').text(cedula);
        $('#del_nombre_txt').text(nombre);
        $('#del_apellido_txt').text(apellido);
        $('#del_email_txt').text(email);
        $('#modalEliminar').modal('show');
    }

    // Cerrar modal Eliminar y limpiar campos
    function cerrarModalEliminar() {
        $('#formEliminar')[0].reset();
        $('#modalEliminar').modal('hide');
    }
</script>
}